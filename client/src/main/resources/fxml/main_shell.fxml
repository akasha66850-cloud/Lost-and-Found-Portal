<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="rootBorderPane" stylesheets="@../css/dashboard.css" styleClass="root-container"
            prefWidth="1200" prefHeight="800"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.campus.lostfound.client.controller.MainShellController">

    <!-- LEFT SIDEBAR -->
    <left>
        <VBox prefWidth="250" spacing="12" styleClass="sidebar">
            <!-- Brand Logo -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <StackPane prefWidth="38" prefHeight="38"
                           style="-fx-background-color: linear-gradient(to bottom right, #6C5CE7, #8072FA); -fx-background-radius: 10;">
                    <SVGPath content="M 12 2 L 2 7 L 12 12 L 22 7 Z M 2 17 L 12 22 L 22 17 M 2 12 L 12 17 L 22 12"
                             fill="WHITE" scaleX="0.8" scaleY="0.8" />
                </StackPane>
                <VBox spacing="0">
                    <Label text="Campus L&amp;F" styleClass="logo-text" />
                    <Label text="Recovery Portal" textFill="#8E92BC" style="-fx-font-size: 11px;" />
                </VBox>
            </HBox>

            <Separator style="-fx-background-color: #232538; -fx-padding: 8 0 8 0;" />

            <!-- Navigation Buttons -->
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                        style="-fx-background-color: transparent; -fx-background: transparent; -fx-padding: 0;"
                        VBox.vgrow="ALWAYS">
                <VBox fx:id="navContainer" spacing="6" style="-fx-background-color: transparent;">
                    <Button fx:id="btnNavDashboard" text="📊  Dashboard" maxWidth="Infinity" styleClass="nav-btn-active" onAction="#showDashboard" />
                    <Button fx:id="btnNavSearch" text="🔍  Search &amp; Browse" maxWidth="Infinity" styleClass="nav-btn" onAction="#showSearch" />

                    <!-- Student Specific -->
                    <Button fx:id="btnNavReportLost" text="➕  Report Lost Item" maxWidth="Infinity" styleClass="nav-btn" onAction="#showReportLost" />
                    <Button fx:id="btnNavMyReports" text="📋  My Reports" maxWidth="Infinity" styleClass="nav-btn" onAction="#showMyReports" />
                    <Button fx:id="btnNavMyClaims" text="🏷️  My Claims" maxWidth="Infinity" styleClass="nav-btn" onAction="#showMyClaims" />

                    <!-- Matches (Student / Staff / Admin) -->
                    <Button fx:id="btnNavMatches" text="⚡  Smart Matches" maxWidth="Infinity" styleClass="nav-btn" onAction="#showMatches" />

                    <!-- Staff / Admin Specific -->
                    <Button fx:id="btnNavLogFound" text="📥  Log Found Item" maxWidth="Infinity" styleClass="nav-btn" onAction="#showLogFound" />
                    <Button fx:id="btnNavInventory" text="📦  Inventory" maxWidth="Infinity" styleClass="nav-btn" onAction="#showInventory" />
                    <Button fx:id="btnNavClaimsReview" text="📝  Claims Review" maxWidth="Infinity" styleClass="nav-btn" onAction="#showClaimsReview" />

                    <!-- Admin Specific -->
                    <Button fx:id="btnNavUsers" text="👥  User Accounts" maxWidth="Infinity" styleClass="nav-btn" onAction="#showUsers" />
                    <Button fx:id="btnNavMerge" text="🔀  Manual Match &amp; Merge" maxWidth="Infinity" styleClass="nav-btn" onAction="#showMerge" />
                    <Button fx:id="btnNavAudit" text="📜  Audit Log" maxWidth="Infinity" styleClass="nav-btn" onAction="#showAudit" />

                    <!-- Notifications with Badge -->
                    <HBox alignment="CENTER_LEFT" maxWidth="Infinity">
                        <Button fx:id="btnNavNotifications" text="🔔  Notifications" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="nav-btn" onAction="#showNotifications" />
                        <Label fx:id="lblUnreadBadge" text="0" styleClass="badge-pill" visible="false" managed="false" />
                    </HBox>
                </VBox>
            </ScrollPane>

            <Separator style="-fx-background-color: #232538; -fx-padding: 4 0 4 0;" />

            <!-- Logout Button -->
            <Button fx:id="btnLogout" text="🚪  Sign Out" maxWidth="Infinity" styleClass="nav-btn-logout" onAction="#handleLogout" />
        </VBox>
    </left>

    <!-- TOP HEADER -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16" styleClass="top-header">
            <VBox spacing="2">
                <Label fx:id="lblViewTitle" text="Dashboard" styleClass="header-title" />
                <Label fx:id="lblViewSubtitle" text="Overview &amp; Recent Activity" textFill="#8E92BC" style="-fx-font-size: 12px;" />
            </VBox>

            <Region HBox.hgrow="ALWAYS" />

            <Label fx:id="lblCurrentDate" text="Friday, Oct 27, 2026" styleClass="header-date" />

            <Separator orientation="VERTICAL" style="-fx-padding: 0 10 0 10; -fx-background-color: #232538;" />

            <!-- User Info Pill -->
            <HBox alignment="CENTER" spacing="10">
                <Circle fx:id="userAvatarCircle" radius="18" fill="#6C5CE7" />
                <VBox alignment="CENTER_LEFT" spacing="1">
                    <Label fx:id="lblUserName" text="User Name" textFill="WHITE" style="-fx-font-weight: bold; -fx-font-size: 13px;" />
                    <Label fx:id="lblUserRole" text="STUDENT" styleClass="badge-role" />
                </VBox>
            </HBox>
        </HBox>
    </top>

    <!-- CENTER DYNAMIC CONTENT PANE -->
    <center>
        <ScrollPane fx:id="contentScroll" fitToWidth="true" fitToHeight="true"
                    styleClass="content-scroll" vbarPolicy="AS_NEEDED" hbarPolicy="NEVER">
            <StackPane fx:id="contentPane" styleClass="content-pane" />
        </ScrollPane>
    </center>

</BorderPane>
